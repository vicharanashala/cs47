# App
NODE_ENV=development
PORT=5000
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-change-this

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGODB_URI=mongodb://escalateiq:password@localhost:27017/escalateiq?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Python Embedding Microservice
EMBEDDING_SERVICE_URL=http://localhost:8001

# Semantic thresholds
FAQ_SIMILARITY_THRESHOLD=0.85
FEED_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5

# Safety
SAFETY_BLOCK_THRESHOLD=0.85
SAFETY_FLAG_THRESHOLD=0.60

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Admin timeouts
ADMIN_ANSWER_TIMEOUT_DAYS=7

# Min reputation to flag
FLAG_MIN_REPUTATION=50
